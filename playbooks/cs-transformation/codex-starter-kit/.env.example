# Đổi tên file này thành ".env" (bỏ ".example") rồi điền giá trị THẬT vào —
# xem hướng dẫn từng bước ở notes/setup-api-access.md và notes/setup-slack-personal-token.md
#
# QUY TẮC BẮT BUỘC: không bao giờ paste giá trị key thật vào chat với Codex,
# không paste vào Slack, không commit file ".env" lên git.avada.net.
# Codex tự đọc file ".env" khi cần — bạn không cần gõ giá trị key ra cho nó thấy.

# === BigQuery — đọc data chat Crisp (avada-crm.avada_cs.crisp_chats) ===
# Nhận qua secret.avada.net, KHÔNG qua Slack/chat. Dùng scope "bigquery" + "cloud-platform".
BQ_SA_CLIENT_EMAIL=
BQ_SA_PRIVATE_KEY_ID=
BQ_SA_PRIVATE_KEY=
# Website ID để lọc đúng app (Chatty/Joy dùng chung 1 ID) — không phải secret, chỉ để filter
CRISP_WEBSITE_RETENTION=72a663b0-4cda-4e3b-8878-426bdd79364c

# === Avada Ticket API — dùng chung 1 key với Liz đang dùng ===
AVD_API_BASE=https://us-central1-avada-crm.cloudfunctions.net/publicAdminApi/api
AVD_TICKET_API_KEY=

# === Slack — personal token (mỗi người tự lấy TOKEN CỦA RIÊNG MÌNH, không dùng chung) ===
# Xem notes/setup-slack-personal-token.md — token này gắn với chính tài khoản Slack của bạn.
SLACK_USER_TOKEN=
