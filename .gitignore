.DS_Store
__pycache__/
*.pyc
.env
.env.*
!*.env.example

# Obsidian vault — personal knowledge base, not tracked in repo
liz-vault/

# Secrets / API keys / OAuth tokens & credentials — anywhere in the repo.
# Deliberately broad: better to over-ignore than leak another token like
# gapi/gmail_token.json (2026-08-28, purged from history + rotated).
*token*.json
*credential*.json
*secret*.json
*apikey*.json
*api-key*.json
*api_key*.json
sa.json
service-account*.json
*.pem
*.p12
*.key
!skills/**/scripts/*.key.example

# kb-sync payloads — temporary: built → Liz reviews → push_kb.py đẩy lên CS v2.
# Không phải audit artifact (KB lưu ở v2), nên không commit vào repo.
reports/analysis/kb-sync-*-payloads.json
# bot-corrections KB-diff payloads — same lifecycle as kb-sync payloads above.
reports/analysis/bot-corrections-*-payloads.json
# kb-sync manual draft files — same lifecycle, reviewed then pushed to CS v2.
reports/analysis/kb-sync-*-draft.md
joy-src/

# cs-daily-brief dedup state — runtime, regenerated each run
skills/cs-daily-brief/state/
