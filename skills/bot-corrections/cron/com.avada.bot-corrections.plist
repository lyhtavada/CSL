<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.avada.bot-corrections</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/avada/CSL/skills/bot-corrections/cron/run-weekly.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/avada/CSL</string>

  <!-- Every Thursday at 10:00 local time.
       Fetches corrections -> commits report -> Claude headless diffs vs KB v2
       -> drafts patch payloads -> DMs Liz on Telegram to review (no auto-push). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>4</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Nếu Mac ngủ/tắt lúc 10:00 T5, launchd chạy ngay khi máy thức. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/bot-corrections.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bot-corrections.log</string>
</dict>
</plist>
