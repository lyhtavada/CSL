# Copy this to ~/avada-cs-ai-agent-crisp-chat/.env.sim and fill in the blanks.
# One-time setup for running kb-test against the sim-crisp pipeline. See
# ../../docs/sim-crisp.md (in the bridge repo) for full background.
#
# This process shares the PROD Postgres (agents/KB/personas already there) but
# only ever writes rows under website_id='sim-crisp' — no real merchant data.

# ── Required: point at prod Postgres via Tailscale + HAProxy ────────────────
# Run `tailscale up` first if not connected. Port 5434 = HAProxy virtual
# endpoint in front of the 3-machine Patroni cluster (see docs/deploy.md).
DATABASE_URL=postgresql://bridge:REPLACE_ME@100.108.181.43:5434/avada_cs_ai_v2

# ── Required: real LLM key (sim still calls the real model, costs real quota) ─
ANTHROPIC_API_KEY=REPLACE_ME

# ── Required: sim process identity ───────────────────────────────────────────
SIM_ENABLED=1
SIM_ONLY=1
PORT=8031
SIM_BASE_URL=http://127.0.0.1:8031
SIM_DB_PATH=data/sim-crisp.sqlite
# Any local-only random string — only used to self-sign the loopback webhook.
CRISP_WEBHOOK_SECRET=REPLACE_ME_LOCAL_ONLY_SECRET

# ── Required: block real side effects (ticket creation, TS AI, CRM lookups) ──
AVADA_TICKET_URL=http://127.0.0.1:8031/sim/mock/ticket
TS_AI_CHAT_SEND_URL=http://127.0.0.1:8031/sim/mock/ts/chat/send
TS_AI_SHOPIFY_ACCESS_URL=http://127.0.0.1:8031/sim/mock/ts/shopify-access/request
CRM_ADMIN_API_BASE=http://127.0.0.1:8031/sim/mock/crm
# These integrations still gate on the credential var being non-empty even
# though the URL above is mocked — any non-empty placeholder works:
AVADA_TICKET_API_KEY=sim-local-placeholder
TS_AI_SERVICE_TOKEN=sim-local-placeholder
CRM_ADMIN_PAT=sim-local-placeholder

# ── Not needed for kb-test (leave blank) ─────────────────────────────────────
# CRISP_PLUGIN_ID / CRISP_PLUGIN_KEY: only needed for /api/sim/crisp-import
# (importing a real Crisp conversation to replay) — skip unless testing that.
